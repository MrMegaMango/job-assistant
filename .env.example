# Optional. Defaults to ~/.local/share/job-assistant on Linux/WSL.
# Never point this inside the Git checkout.
JOB_ASSISTANT_DATA_DIR=

# Optional. Uses disposable data and disables private/profile/application writes.
# Vercel enables this mode automatically.
JOB_ASSISTANT_HOSTED_DEMO=

# Optional discovery sources that need credentials.
USAJOBS_EMAIL=
USAJOBS_API_KEY=
CAREERONESTOP_USER_ID=
CAREERONESTOP_TOKEN=

# Optional model provider. The MVP's ranking works without an LLM.
OPENAI_API_KEY=
