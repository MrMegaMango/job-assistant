{
	"name": "high-match-job-assistant",
	"private": true,
	"version": "0.1.0",
	"description": "A local-first assistant for finding, ranking, and preparing high-match job applications.",
	"homepage": "https://high-match-job-assistant.vercel.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/MrMegaMango/job-assistant.git"
	},
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "node scripts/harden-vercel-adapter.mjs && vite build && node scripts/audit-vercel-output.mjs",
		"start": "vite preview --host 127.0.0.1 --port 4173",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "node scripts/harden-vercel-adapter.mjs && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"ci": "npm run check && npm test && npm run build"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@supabase/ssr": "^0.7.0",
		"@supabase/supabase-js": "^2.115.0",
		"better-sqlite3": "^13.0.3",
		"zod": "^4.4.3"
	},
	"overrides": {
		"cookie": "0.7.2"
	}
}
